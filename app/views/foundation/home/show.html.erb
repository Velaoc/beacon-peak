# Public marketing root for Beacon Peak. The visitor-facing shell (top app
# bar + footer) is rendered by the application layout; the signed-in shell
# and floating nav apply only to account/organization pages.
<% title "Beacon Peak — Analytics that show the whole picture" %>
<% description "Beacon turns product, web, and revenue data into one clear view. See what's working, what's not, and what to build next." %>

<section class="md-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow">Beacon Peak</p>
      <h1 id="hero-title" class="md-display">See your product clearly.</h1>
      <p class="md-hero__lede">Beacon pulls your web, product, and revenue data into one live view — so you know what's working, what's not, and what to build next.</p>
      <div class="md-actions">
        <% if user_signed_in? %>
          <%= link_to "Open your workspace", organizations.organizations_path, class: "md-button md-button--filled" %>
        <% else %>
          <%= link_to "Get early access", root_path(anchor: "signup"), class: "md-button md-button--filled" %>
          <%= link_to "View pricing", pricing_path, class: "md-button md-button--outlined" %>
        <% end %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true">
      <div class="md-hero__orb"></div>
    </div>
  </div>
</section>

<section class="md-section" id="features" aria-labelledby="features-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Features</p>
    <h2 id="features-title" class="md-section__heading">Everything your numbers need, in one place.</h2>
    <div class="md-grid">
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:monitoring, size: 32) %></span>
        <div>
          <h3>Live dashboards</h3>
          <p>Dashboards refresh as data arrives, so the number you're looking at is the number that's true right now — not yesterday's export.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:query_stats, size: 32) %></span>
        <div>
          <h3>Funnel insights</h3>
          <p>See where visitors drop off and which step costs you the most. Every funnel comes with the next best thing to test.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:sync, size: 32) %></span>
        <div>
          <h3>Works with your stack</h3>
          <p>Beacon connects to the tools you already use, with one place to manage sources and keep your data in sync.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:group, size: 32) %></span>
        <div>
          <h3>Built for teams</h3>
          <p>Shared dashboards, scoped access, and a workspace your whole team can read — without everyone needing a data degree.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:notifications, size: 32) %></span>
        <div>
          <h3>Alerts that matter</h3>
          <p>Beacon watches your metrics and tells you when something moves — spikes, drops, or a goal finally crossing the line.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:shield, size: 32) %></span>
        <div>
          <h3>Private by default</h3>
          <p>Encryption in transit and at rest, workspace-scoped access, and controls that keep your data yours.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="md-section" id="pricing" aria-labelledby="pricing-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Pricing</p>
    <h2 id="pricing-title" class="md-section__heading">Simple plans that scale with you.</h2>
    <div class="md-pricing-grid">
      <% @plans.each do |plan| %>
        <article class="md-card md-card--filled md-pricing-card <%= plan[:highlighted] ? "md-pricing-card--highlighted" : "" %>">
          <h3><%= plan[:name] %></h3>
          <p class="md-pricing-card__price">
            <%= number_to_currency(plan[:price], precision: 0) %>
            <span>/ month</span>
          </p>
          <p><%= plan[:description] %></p>
          <ul class="md-pricing-card__bullets">
            <% plan[:bullets].each do |bullet| %>
              <li><%= bullet %></li>
            <% end %>
          </ul>
          <%= link_to plan[:cta_label], instance_exec(&plan[:cta_route]), class: "md-button #{plan[:highlighted] ? "md-button--filled" : "md-button--outlined"}" %>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="md-section" id="faq" aria-labelledby="faq-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">FAQ</p>
    <h2 id="faq-title" class="md-section__heading">Questions, answered.</h2>
    <div class="md-faq">
      <% @faqs.each do |faq| %>
        <details class="md-faq__item">
          <summary><%= faq[:q] %></summary>
          <p><%= faq[:a] %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>

<section class="md-section" id="signup" aria-labelledby="signup-title">
  <div class="md-section__inner md-signup">
    <p class="md-section__eyebrow">Early access</p>
    <h2 id="signup-title" class="md-section__heading">Be first in line.</h2>
    <p>Leave your email and we'll reach out when Beacon opens to your team.</p>
    <%= form_with url: leads_path, method: :post, class: "md-stack md-signup__form" do |form| %>
      <div class="md-field">
        <%= form.label :email, "Work email" %>
        <%= form.email_field "lead[email]", required: true, autocomplete: "email", placeholder: "you@company.com" %>
      </div>
      <div class="md-field">
        <%= form.label :name, "Name" %>
        <%= form.text_field "lead[name]", autocomplete: "name", placeholder: "Ada Lovelace" %>
      </div>
      <div class="md-actions">
        <%= form.submit "Get early access", class: "md-button md-button--filled" %>
      </div>
    <% end %>
  </div>
</section>
